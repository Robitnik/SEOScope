# Скопіюй у .env (не комітиться) та заповни значення.
APP_NAME=
ENVIRONMENT=
LOG_LEVEL=
DATABASE_URL=
ARTIFACTS_DIR=
BROWSER_PROFILES_DIR=
AISEOTOOLS_SOURCE_PATH=/seo/AISeoTools
FRONTEND_DIR=
EVENT_RETENTION_DAYS=
JOB_LEASE_SECONDS=
HTTP_REQUEST_TIMEOUT_SECONDS=
CORS_ALLOW_ORIGINS=

# Не читається застосунком (Settings) — лише docker-compose var substitution.
# Шлях до сусіднього checkout AISeoTools; лишити порожнім, якщо він лежить
# за замовчуванням у ../../seo/AISeoTools відносно цього репо.
AISEOTOOLS_PATH=

# Browser-профілі та isolated Chrome AISeoTools беруться з
# ${HOME}/.local/share/seo-audit і монтуються compose автоматично.
# Ключі провайдерів читаються з ${AISEOTOOLS_PATH}/.env.

# Не читається застосунком (Settings) — лише docker-compose var substitution.
# UID/GID, від якого працюють api та worker. Контейнер НІКОЛИ не працює від root:
# він пише у спільні з хостом теки (state/locks, downloads), а root-івський файл
# там назавжди замикає хостовий CLI (flock потребує O_RDWR, а umask 022 знімає
# біт запису з 0666). Значення має збігатися з власником
# ${HOME}/.local/share/seo-audit, а не цього репозиторію:
#   id -u  /  id -g
# Порожньо → 1000:1000.
DOCKER_UID=
DOCKER_GID=

# ── Dev-доступ без входу (task-73) ───────────────────────────────────────
# Обидва прапорці нижче МЕРТВІ, коли ENVIRONMENT=production — незалежно від
# значення (перевіряється в app/core/auth/sessions.py). Ніколи не заповнюй
# їх у продовому .env/деплої; тут лишаються порожніми навмисно.
#
# Спільний секрет для паралельних агентів-розробників: curl/Playwright-скрипт
# додає заголовок `Authorization: Bearer <значення>` і працює без POST
# /auth/login. Згенерувати: python3 -c "import secrets; print(secrets.token_hex(32))"
AGENT_DEV_TOKEN=
# Вхід без пароля на http://localhost:6524/ для оператора цієї машини.
# УВАГА: `network_mode: host` (compose.yaml) означає, що Cloudflare-тунель
# форвардить на ту саму адресу 127.0.0.1, що й браузер на localhost —
# безпечним це робить ЛИШЕ перевірка на відсутність заголовків тунелю/проксі
# (Cf-Connecting-Ip, X-Forwarded-For тощо) у `is_trusted_loopback()`, а не сам
# прапорець. true/false.
AUTH_LOCALHOST_BYPASS=
