# Скопіюй у .env (не комітиться) та заповни значення.
APP_NAME=
ENVIRONMENT=
LOG_LEVEL=
DATABASE_URL=
ARTIFACTS_DIR=
BROWSER_PROFILES_DIR=
AISEOTOOLS_SOURCE_PATH=/seo/AISeoTools
FRONTEND_DIR=
EVENT_RETENTION_DAYS=
JOB_LEASE_SECONDS=
HTTP_REQUEST_TIMEOUT_SECONDS=
CORS_ALLOW_ORIGINS=

# Не читається застосунком (Settings) — лише docker-compose var substitution.
# Шлях до сусіднього checkout AISeoTools; лишити порожнім, якщо він лежить
# за замовчуванням у ../../seo/AISeoTools відносно цього репо.
AISEOTOOLS_PATH=

# Browser-профілі та isolated Chrome AISeoTools беруться з
# ${HOME}/.local/share/seo-audit і монтуються compose автоматично.
# Ключі провайдерів читаються з ${AISEOTOOLS_PATH}/.env.
